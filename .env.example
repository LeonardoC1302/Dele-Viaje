# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase — Project Settings -> API Keys
# Use the new "publishable" / "secret" keys, not the legacy anon / service_role
# JWT keys (both still work, but publishable/secret is the current default and
# can be rotated independently of the JWT secret).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Must match Supabase Auth -> URL Configuration -> Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console -> Credentials)
# Also entered directly in Supabase Auth -> Providers -> Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
