# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable: keep the design system + direction contracts, drop the
# per-run scratch (screenshots, hook cache, served question payloads).
/.impeccable/review/
/.impeccable/questions/
/.impeccable/hook.cache.json
/.impeccable/config.local.json

# Copied out of node_modules by scripts/sync-maplibre-worker.mjs
# on predev/prebuild — see lib/maplibre-worker.ts.
/public/maplibre-gl-worker.mjs
/public/maplibre-gl-shared.mjs
